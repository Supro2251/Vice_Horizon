{
  "entities": {
    "UserSaveProfile": {
      "title": "UserSaveProfile",
      "description": "Top-level player save metadata and global progression for Vice Horizon.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "nickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "activeCharacterId": {
          "type": "string",
          "enum": ["lucia", "mateo", "kairo"]
        },
        "cash": {
          "type": "number"
        },
        "totalEliminations": {
          "type": "number"
        },
        "policeEscapes": {
          "type": "number"
        },
        "stuntJumps": {
          "type": "number"
        },
        "shootingRangeScore": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "activeCharacterId", "cash", "totalEliminations", "policeEscapes", "stuntJumps", "createdAt", "updatedAt"]
    },
    "CharacterSave": {
      "title": "CharacterSave",
      "description": "Per-character wallet, skills, 3D coordinates, appearance, and saved custom outfits.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["lucia", "mateo", "kairo"]
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cash": { "type": "number" },
        "skills": { "type": "object" },
        "health": { "type": "number" },
        "armor": { "type": "number" },
        "posX": { "type": "number" },
        "posY": { "type": "number" },
        "posZ": { "type": "number" },
        "heading": { "type": "number" },
        "appearance": { "type": "object" },
        "customOutfits": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "health", "armor", "posX", "posY", "posZ", "heading", "appearance", "customOutfits", "updatedAt"]
    },
    "InventorySave": {
      "title": "InventorySave",
      "description": "Player weapons, parachute, consumables, contraband, and equipped loadout.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "equippedWeapon": { "type": "string", "maxLength": 32 },
        "hasParachute": { "type": "boolean" },
        "weapons": { "type": "array" },
        "consumables": { "type": "array" },
        "contraband": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "equippedWeapon", "weapons", "consumables", "contraband", "updatedAt"]
    },
    "SettingsSave": {
      "title": "SettingsSave",
      "description": "Graphics, audio, key/controller remapping, HUD mod theme, and gameplay mutators.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "graphics": { "type": "object" },
        "audio": { "type": "object" },
        "controls": { "type": "object" },
        "hudMod": { "type": "object" },
        "gameplayMods": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "graphics", "audio", "controls", "hudMod", "gameplayMods", "updatedAt"]
    },
    "MissionSave": {
      "title": "MissionSave",
      "description": "Story and discovered side mission progress and completion statistics.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["available", "active", "completed", "discovered"]
        },
        "completedCount": { "type": "number" },
        "bestTimeSec": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "status", "completedCount", "bestTimeSec", "updatedAt"]
    },
    "GarageSave": {
      "title": "GarageSave",
      "description": "Persisted aircraft inside Bayshore Hangar and ground vehicles inside Safehouse Garage.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hangarVehicles": { "type": "array" },
        "safehouseVehicles": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "hangarVehicles", "safehouseVehicles", "updatedAt"]
    },
    "PublicUserCard": {
      "title": "PublicUserCard",
      "description": "Public directory card so friends can look each other up by nickname, friend code, or email.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nickname": { "type": "string", "minLength": 2, "maxLength": 32 },
        "nicknameLower": { "type": "string", "minLength": 2, "maxLength": 32 },
        "emailLower": { "type": "string", "maxLength": 160 },
        "friendCode": { "type": "string", "minLength": 4, "maxLength": 24 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "friendCode", "updatedAt"]
    },
    "FriendSave": {
      "title": "FriendSave",
      "description": "Saved friend entry under a player's friends list for automatic multiplayer joins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nickname": { "type": "string", "minLength": 2, "maxLength": 32 },
        "email": { "type": "string", "maxLength": 160 },
        "friendCode": { "type": "string", "minLength": 4, "maxLength": 24 },
        "addedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "ownerId", "displayName", "friendCode", "addedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserSaveProfile" },
      "description": "Primary player save document owned exclusively by userId."
    },
    "/users/{userId}/characters/{characterId}": {
      "schema": { "$ref": "#/entities/CharacterSave" },
      "description": "Per-character wallet, skills, appearance, custom outfits, health/armor, and 3D coordinates."
    },
    "/users/{userId}/inventory/{slotId}": {
      "schema": { "$ref": "#/entities/InventorySave" },
      "description": "Player inventory, parachute, and equipped weapon state."
    },
    "/users/{userId}/settings/{profileId}": {
      "schema": { "$ref": "#/entities/SettingsSave" },
      "description": "Persisted graphics, audio, keybindings, controller mappings, and HUD mods."
    },
    "/users/{userId}/missions/{missionId}": {
      "schema": { "$ref": "#/entities/MissionSave" },
      "description": "Per-mission progress and completion statistics."
    },
    "/users/{userId}/garage/{slotId}": {
      "schema": { "$ref": "#/entities/GarageSave" },
      "description": "Persisted hangar aircraft and safehouse garage vehicles."
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": { "$ref": "#/entities/FriendSave" },
      "description": "Player friends roster for automatic multiplayer meets."
    },
    "/publicUsers/{userId}": {
      "schema": { "$ref": "#/entities/PublicUserCard" },
      "description": "Public friend code directory card for friend discovery."
    }
  }
}
