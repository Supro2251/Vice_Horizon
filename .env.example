# PORT: Port injected automatically by Render in production (defaults to 3000 locally)
PORT=3000

# NODE_ENV: Set to "production" on Render servers
NODE_ENV="development"

# APP_URL: Public URL of the deployed Render Web Service (e.g. https://vice-horizon.onrender.com)
# Note: Add your Render domain (*.onrender.com) to Firebase Authentication -> Authorized domains for Google Login.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Optional AI Studio runtime variable
GEMINI_API_KEY="MY_GEMINI_API_KEY"
